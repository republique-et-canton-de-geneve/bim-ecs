{
  "author": "Etat de Genève",
  "description": "Typescript ECS library implementation",
  "keywords": [
    "ECS",
    "Game engine",
    "typescript",
    "javascript",
    "BIM"
  ],
  "license": "Apache-2.0",
  "private": true,
  "version": "0.0.11",
  "workspaces": [
    "./packages/*",
    "./libs/*",
    "./demo/*"
  ],
  "scripts": {
    "build:all": "pnpm --filter bim-ecs... build && pnpm --filter @bim-ecs-grouped-component-plugin... build",
    "start:demo-arkanoid": "pnpm --filter @bim-ecs/ecs-arkanoid... build && pnpm --filter @bim-ecs/ecs-arkanoid... start",
    "sync-packages-versions": "node ./cli/versions/sync-package-versions.js",
    "prepublish": "node ./cli/readme/copy-readme.js"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "glob": "^13.0.6"
  }
}
